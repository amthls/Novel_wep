# ============================================================================
# NOVEL & MANGA PLATFORM - ENVIRONMENT TEMPLATE
# ============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=novel_platform
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Full Database Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/novel_platform?schema=public

# Backend API Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SITE_NAME="NovelHub"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional pgAdmin Port
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@novelhub.vn
PGADMIN_DEFAULT_PASSWORD=admin

# Authentication Security (JWT)
JWT_SECRET=super_secret_jwt_novelhub_key_2026_x89a@!secure
JWT_EXPIRES_IN=7d
